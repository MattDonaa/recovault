# RecoVault — Environment Variable Template
# Copy to `.env.local` and fill with real values. NEVER commit real secrets.
# Milestone 01 uses only APP-level, non-secret configuration.
# Supabase / marketplace credential variables are introduced in their own milestones.

# Application
NEXT_PUBLIC_APP_NAME=RecoVault
NEXT_PUBLIC_APP_ENV=development

# Node environment (development | test | production)
NODE_ENV=development

# Supabase (Milestone 02+)
# URL and anon/publishable key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
# SECRET — server-only. Bypasses Row-Level Security. NEVER expose to the client
# and NEVER commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Marketplace credential encryption (Milestone 06+)
# SECRET — server-only. 32-byte AES-256 key, base64 or hex encoded. Used to
# encrypt marketplace credentials before database persistence. NEVER stored in
# the database and NEVER exposed to the client. Required in production.
# Generate: `openssl rand -base64 32`
MARKETPLACE_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# Takealot Marketplace API (Milestone 05+)
# SECRET — server-only. Sent as the X-API-Key header inside the adapter/transport.
# Never expose to the client or persist client-side. Live calls are not part of
# CI/MVP; this is used only when connecting a real seller (live-pilot milestone).
TAKEALOT_API_KEY=your-takealot-marketplace-api-key

# Auth session signing (Milestone 03+)
# SECRET — server-only. Used to sign the application session cookie (HMAC).
# Required (>=16 chars) in production; a dev fallback is used otherwise.
# When all three Supabase vars above are set, auth runs in LIVE mode; otherwise
# it runs in MOCK-FIRST mode with an in-memory provider.
AUTH_SESSION_SECRET=a-long-random-secret-at-least-16-chars
